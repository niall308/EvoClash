{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_daily_reward_ready",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_daily_reward": {
          "call": "invoke_backend_function",
          "with": {
