{
  "name": "Expire Trade Requests",
  "description": "Marks pending trade requests older than 1 week as expired, and deletes expired trades after 30 days.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "expire_trade_requests",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "expire_trades": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "expireTrades"
          },
          "then": "end",
          "x-base44": {
            "title": "Expire old trades",
            "description": "Expire >7d, delete >30d"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/Toronto",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}