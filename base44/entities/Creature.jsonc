{
  "name": "Creature",
  "type": "object",
  "properties": {
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature",
        "Hybrid"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "predator",
        "prey",
        "balanced",
        "hyper_rare"
      ],
      "default": "balanced"
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "Admin-facing anatomy/design guide for the AI card generator."
    },
    "referenceImageUrl": {
      "type": "string",
      "default": "",
      "description": "Admin-approved generated image used as an anatomy reference for future AI card art of this creature."
    },
    "uniqueAttackName": {
      "type": "string",
      "default": "",
      "description": "Display name of this creature's Unique Attack."
    },
    "uniqueAttackPercent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 200,
      "description": "Damage percentage of the Unique Attack (0\u2013200). 0/empty falls back to 100% at resolve time."
    },
    "uniqueAttackTarget": {
      "type": "string",
      "enum": [
        "single",
        "all"
      ],
      "default": "single",
      "description": "Whether the Unique Attack hits one card (single) or all opposing cards (all). Legacy 'multi' is normalized to 'all'."
    },
    "uniqueAttackEffectType": {
      "type": "string",
      "enum": [
        "none",
        "healSelf",
        "healAll",
        "halfAttackTarget",
        "healTeamOnDestroy"
      ],
      "default": "none",
      "description": "Canonical structured effect identifier. Free-text uniqueAttackEffect is display-only and never executed as logic."
    },
    "uniqueAttackEffectPercent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 200,
      "description": "Effect magnitude (percent) for effects that scale by a percentage (healSelf/healAll/healTeamOnDestroy)."
    },
    "uniqueAttackEffectDuration": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 10,
      "description": "Effect duration in turns for effects that persist (halfAttackTarget)."
    },
    "uniqueAttackEffect": {
      "type": "string",
      "default": "",
      "description": "Admin-facing effect description (display only \u2014 not parsed as a mechanic)."
    }
  },
  "required": [
    "baseName",
    "category",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}