{
  "name": "Creature",
  "type": "object",
  "properties": {
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature",
        "Hybrid",
        "Prototype"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "predator",
        "prey",
        "balanced",
        "hyper_rare"
      ],
      "default": "balanced"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "referenceImageUrl": {
      "type": "string",
      "default": "",
      "description": "Admin-approved generated image used as an anatomy reference for future AI card art of this creature."
    },
    "tier1Image": {
      "type": "string",
      "default": "",
      "description": "Admin-uploaded reference card image for this creature's Tier 1 form."
    },
    "tier2Image": {
      "type": "string",
      "default": "",
      "description": "Admin-uploaded reference card image for this creature's Tier 2 form."
    },
    "tier3Image": {
      "type": "string",
      "default": "",
      "description": "Admin-uploaded reference card image for this creature's Tier 3 form."
    },
    "tier4Image": {
      "type": "string",
      "default": "",
      "description": "Admin-uploaded reference card image for this creature's Tier 4 form."
    },
    "uniqueAttackName": {
      "type": "string",
      "default": "",
      "description": "Display name of this creature's Unique Attack."
    },
    "uniqueAttackPercent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 250,
      "description": "Damage percentage of the Unique Attack (0\u2013250)."
    },
    "uniqueAttackTarget": {
      "type": "string",
      "enum": [
        "single",
        "multi"
      ],
      "default": "single",
      "description": "Whether the Unique Attack hits one card (single) or all opposing cards (multi)."
    },
    "uniqueAttackEffect": {
      "type": "string",
      "default": "",
      "description": "Additional effect description for the Unique Attack, e.g. 'halves target's attack next turn'."
    },
    "eggBabyName": {
      "type": "string",
      "default": "",
      "description": "Display name for the baby card this creature hatches into from an egg. Falls back to baseName if empty."
    },
    "eggUpgradedName": {
      "type": "string",
      "default": "",
      "description": "Legacy shared upgraded (Tier 4) display name. Retained as a fallback when the per-alignment name is empty. Prefer eggUpgradedGoodName / eggUpgradedEvilName."
    },
    "eggUpgradedGoodName": {
      "type": "string",
      "default": "",
      "description": "Display name for the Good upgraded (Tier 4) form of this creature's egg hatchling. Falls back to eggUpgradedName, then to the baby name."
    },
    "eggUpgradedEvilName": {
      "type": "string",
      "default": "",
      "description": "Display name for the Evil upgraded (Tier 4) form of this creature's egg hatchling. Falls back to eggUpgradedName, then to the baby name."
    },
    "eggBabyImages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Card-art image URLs for the baby form. One is chosen at random when an egg hatches. A creature needs at least one to be eligible as an egg hatch."
    },
    "eggUpgradedGoodImages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Card-art image URLs for the Good upgraded (Tier 4) form. When a hatchling is upgraded there is a 50/50 chance of Good vs Evil; one Good image is chosen at random."
    },
    "eggUpgradedEvilImages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Card-art image URLs for the Evil upgraded (Tier 4) form. When a hatchling is upgraded there is a 50/50 chance of Good vs Evil; one Evil image is chosen at random."
    }
  },
  "required": [
    "baseName",
    "category",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}