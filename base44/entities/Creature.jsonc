{
  "name": "Creature",
  "type": "object",
  "properties": {
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature",
        "Hybrid"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "predator",
        "prey",
        "balanced",
        "hyper_rare"
      ],
      "default": "balanced"
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "Anatomy/design guide for the AI card art generator."
    },
    "referenceImageUrl": {
      "type": "string",
      "default": "",
      "description": "Admin-approved generated image used as an anatomy reference for future AI card art of this creature."
    },
    "uniqueAttackName": {
      "type": "string",
      "default": "",
      "description": "Canonical UA field: display name of this creature's Unique Attack."
    },
    "uniqueAttackPercent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 200,
      "description": "Canonical UA field: damage percentage (0\u2013200)."
    },
    "uniqueAttackTarget": {
      "type": "string",
      "enum": [
        "single",
        "all"
      ],
      "default": "single",
      "description": "Canonical UA field: 'single' hits one card, 'all' hits every opposing card."
    },
    "uniqueAttackEffectType": {
      "type": "string",
      "enum": [
        "none",
        "heal_self",
        "heal_team",
        "heal_team_on_destroy",
        "half_attack_target",
        "custom"
      ],
      "default": "none",
      "description": "Canonical UA field: structured effect identifier. See src/lib/uniqueAttacks.js EFFECT_TYPES."
    },
    "uniqueAttackEffectPercent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 200,
      "description": "Canonical UA field: numeric parameter for effects that scale by percentage (heal amount, etc.)."
    },
    "uniqueAttackEffectDuration": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Canonical UA field: numeric parameter for effects with a duration in turns (e.g. half_attack_target)."
    },
    "uniqueAttackEffect": {
      "type": "string",
      "default": "",
      "description": "Canonical UA field: admin-facing display description only. The mechanic is driven by uniqueAttackEffectType, not this text."
    }
  },
  "required": [
    "baseName",
    "category",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}