{
  "name": "Creature",
  "type": "object",
  "properties": {
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature",
        "Hybrid"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "predator",
        "prey",
        "balanced",
        "hyper_rare"
      ],
      "default": "balanced"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "referenceImageUrl": {
      "type": "string",
      "default": "",
      "description": "Admin-approved generated image used as an anatomy reference for future AI card art of this creature."
    }
  },
  "required": [
    "baseName",
    "category",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}