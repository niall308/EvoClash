{
  "name": "Creature",
  "type": "object",
  "properties": {
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature",
        "Hybrid"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "predator",
        "prey",
        "balanced",
        "hyper_rare"
      ],
      "default": "balanced"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "referenceImageUrl": {
      "type": "string",
      "default": "",
      "description": "Admin-approved generated image used as an anatomy reference for future AI card art of this creature."
    },
    "uniqueAttackName": {
      "type": "string",
      "default": "",
      "description": "Display name of this creature's Unique Attack."
    },
    "uniqueAttackPercent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 200,
      "description": "Damage percentage of the Unique Attack (0\u2013200). 0 means no Unique Attack configured."
    },
    "uniqueAttackTarget": {
      "type": "string",
      "enum": [
        "single",
        "all"
      ],
      "default": "single",
      "description": "Whether the Unique Attack hits one opposing card (single) or all opposing cards (all)."
    },
    "uniqueAttackEffect": {
      "type": "string",
      "default": "",
      "description": "Free-text display-only description of the Unique Attack's effect (flavor text; the actual mechanic is uniqueAttackEffectType)."
    },
    "uniqueAttackEffectType": {
      "type": "string",
      "enum": [
        "none",
        "healSelf",
        "healAll",
        "halfAttack",
        "healTeamOnDestroy"
      ],
      "default": "none",
      "description": "Structured effect mechanic applied by the battle resolver. 'none' = damage only. healTeamOnDestroy heals all active allied cards 20% max HP after destroying an opposing card."
    }
  },
  "required": [
    "baseName",
    "category",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}