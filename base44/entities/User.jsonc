{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "profilePictureUrl": {
      "type": "string",
      "default": ""
    },
    "friendCode": {
      "type": "string",
      "default": ""
    },
    "isAdmin": {
      "type": "boolean",
      "default": false
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "gamesPlayed": {
      "type": "number",
      "default": 0
    },
    "aiGamesPlayed": {
      "type": "number",
      "default": 0
    },
    "milestoneClaimCounts": {
      "type": "object",
      "default": {}
    },
    "coins": {
      "type": "number",
      "default": 0
    },
    "totalCardsCreated": {
      "type": "number",
      "default": 0
    },
    "dailyFreeCreations": {
      "type": "number",
      "default": 0
    },
    "dailyFreeResetAt": {
      "type": "string",
      "default": ""
    },
    "burnPowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "reshufflePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "doubleAttackPowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "defensePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "blockPowerUsesToday": {
      "type": "number",
      "default": 0
    },
    "blockPowerResetAt": {
      "type": "string",
      "default": ""
    },
    "halfAttackPowerUsesToday": {
      "type": "number",
      "default": 0
    },
    "halfAttackPowerResetAt": {
      "type": "string",
      "default": ""
    },
    "t2UpgradePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "t3UpgradePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "t4UpgradePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "lastSeenAt": {
      "type": "string",
      "default": ""
    },
    "activePowerUps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "burn",
        "reshuffle",
        "doubleAttack",
        "defense"
      ]
    },
    "creaturesSummoned": {
      "type": "number",
      "default": 0
    },
    "creaturesEvolved": {
      "type": "number",
      "default": 0
    },
    "evolvedCardIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tier2Upgrades": {
      "type": "number",
      "default": 0
    },
    "tier3Upgrades": {
      "type": "number",
      "default": 0
    },
    "tier4Upgrades": {
      "type": "number",
      "default": 0
    },
    "creatureEvolutionLinesCompleted": {
      "type": "number",
      "default": 0
    },
    "completedEvolutionCardIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "distinctTypesOwnedCount": {
      "type": "number",
      "default": 0
    },
    "ownedElementTypesList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "threeElementMatches": {
      "type": "number",
      "default": 0
    },
    "winsUnder100HP": {
      "type": "number",
      "default": 0
    },
    "flawlessWins": {
      "type": "number",
      "default": 0
    },
    "monoElementWins": {
      "type": "number",
      "default": 0
    },
    "totalDamageDealt": {
      "type": "number",
      "default": 0
    },
    "successfulBlocks": {
      "type": "number",
      "default": 0
    },
    "fastWins": {
      "type": "number",
      "default": 0
    },
    "comebackWins": {
      "type": "number",
      "default": 0
    },
    "defeatedHigherTierOpponent": {
      "type": "number",
      "default": 0
    },
    "currentWinStreak": {
      "type": "number",
      "default": 0
    },
    "maxWinStreak": {
      "type": "number",
      "default": 0
    },
    "rankPoints": {
      "type": "number",
      "default": 500
    },
    "pvpGamesPlayed": {
      "type": "number",
      "default": 0
    },
    "pvpWins": {
      "type": "number",
      "default": 0
    },
    "pvpLosses": {
      "type": "number",
      "default": 0
    },
    "currentPvpStreak": {
      "type": "number",
      "default": 0
    },
    "maxPvpWinStreak": {
      "type": "number",
      "default": 0,
      "description": "Longest consecutive PvP (online + offline) win streak ever reached. Used for the win-streak leaderboard \u2014 never affected by AI battles."
    },
    "highestStoryStage": {
      "type": "number",
      "default": 0,
      "description": "Highest Story Mode stage number the player has completed (cleared the boss)."
    },
    "storyMatchesWon": {
      "type": "number",
      "default": 0
    },
    "bossFightsWon": {
      "type": "number",
      "default": 0
    },
    "bossFlawlessWins": {
      "type": "number",
      "default": 0
    },
    "stagesCompletedNoPowerUps": {
      "type": "number",
      "default": 0
    },
    "maxStagesNoLossStreak": {
      "type": "number",
      "default": 0,
      "description": "Longest run of consecutive Story stages cleared without losing a match."
    },
    "currentStagesNoLossStreak": {
      "type": "number",
      "default": 0
    },
    "bossFirstAttemptWins": {
      "type": "number",
      "default": 0
    },
    "finalBossDefeated": {
      "type": "number",
      "default": 0
    },
    "storyBossLostStages": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [],
      "description": "Story stage numbers whose boss was lost at least once, so a later win isn't counted as a first-attempt win."
    },
    "lastDailyRewardClaimedAt": {
      "type": "string",
      "default": "",
      "description": "EST calendar date (YYYY-MM-DD) the daily reward was last claimed."
    },
    "lastDailyRewardNotifiedAt": {
      "type": "string",
      "default": "",
      "description": "EST calendar date (YYYY-MM-DD) the user was last emailed that their daily reward is ready."
    },
    "notifyBattleInvites": {
      "type": "boolean",
      "default": true
    },
    "notifyDailyRewardReady": {
      "type": "boolean",
      "default": true
    },
    "notifyTradeRequests": {
      "type": "boolean",
      "default": true
    },
    "notifyYourTurn": {
      "type": "boolean",
      "default": true,
      "description": "Whether to email the user when it becomes their turn in an offline PvP match."
    },
    "notifyLobbyJoin": {
      "type": "boolean",
      "default": true,
      "description": "Whether to email the user when someone joins their lobby."
    },
    "autoBuildOffered": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has already been shown the one-time offer to auto-build their first 15 cards."
    },
    "dailyMissionsDate": {
      "type": "string",
      "default": "",
      "description": "UTC calendar date (YYYY-MM-DD) the daily missions were last reset."
    },
    "dailyMissionsBaseline": {
      "type": "object",
      "default": {},
      "description": "Snapshot of each daily mission's lifetime metric value at the last reset, used to compute today's progress."
    },
    "dailyMissionsClaimed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of daily missions already claimed since the last reset."
    }
  }
}