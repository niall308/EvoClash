      "type": "number",
      "default": 0
    },
    "dailyFreeCreations": {
      "type": "number",
      "default": 0
    },
    "dailyFreeResetAt": {
      "type": "string",
      "default": ""
    },
    "burnPowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "reshufflePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "doubleAttackPowerUsedAt": {
      "type": "string",
