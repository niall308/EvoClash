{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "isAdmin": {
      "type": "boolean",
      "default": false
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "gamesPlayed": {
      "type": "number",
      "default": 0
    },
    "coins": {
      "type": "number",
      "default": 0
    },
    "claimedMilestoneIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "totalCardsCreated": {
      "type": "number",
      "default": 0
    },
    "dailyFreeCreations": {
      "type": "number",
      "default": 0
    },
    "dailyFreeResetAt": {
      "type": "string",
      "default": ""
    },
    "burnPowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "reshufflePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "doubleAttackPowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "defensePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "blockPowerUsesToday": {
      "type": "number",
      "default": 0
    },
    "blockPowerResetAt": {
      "type": "string",
      "default": ""
    },
    "halfAttackPowerUsesToday": {
      "type": "number",
      "default": 0
    },
    "halfAttackPowerResetAt": {
      "type": "string",
      "default": ""
    },
    "t2UpgradePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "t3UpgradePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "t4UpgradePowerUsedAt": {
      "type": "string",
      "default": ""
    },
    "activePowerUps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "burn",
        "reshuffle",
        "doubleAttack",
        "defense"
      ]
    }
  }
}