{
  "name": "StoryProgress",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "currentStage": {
      "type": "number",
      "default": 1
    },
    "currentMatch": {
      "type": "number",
      "default": 1
    },
    "completedMatches": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "stageCompleted": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "storyCompleted": {
      "type": "boolean",
      "default": false
    },
    "storyBattleStartedAt": {
      "type": "string",
      "default": "",
      "description": "ISO timestamp of when the current story battle session started (set by startStoryBattle). finalizeStoryBattle requires this to exist and to have aged past a playable minimum before granting rewards, so a client can't farm story rewards without playing."
    }
  },
  "required": [
    "userId"
  ],
  "rls": {
    "create": {
      "data.userId": "{{user.id}}"
    },
    "read": {
      "data.userId": "{{user.id}}"
    },
    "update": {
      "data.userId": "{{user.id}}"
    },
    "delete": {
      "data.userId": "{{user.id}}"
    }
  }
}