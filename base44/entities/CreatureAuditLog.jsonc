{
  "name": "CreatureAuditLog",
  "type": "object",
  "properties": {
    "creatureId": {
      "type": "string"
    },
    "imageId": {
      "type": "string",
      "default": ""
    },
    "tier": {
      "type": "number",
      "default": 0,
      "description": "Tier associated with the audited action when relevant (generate/approve/set-default). 0 = not applicable."
    },
    "action": {
      "type": "string",
      "enum": [
        "generate_requested",
        "generate_completed",
        "generate_failed",
        "image_uploaded",
        "image_approved",
        "image_rejected",
        "default_changed",
        "unique_attack_updated",
        "approve_guide",
        "reject_image",
        "set_default",
        "guide_used"
      ]
    },
    "userId": {
      "type": "string",
      "default": ""
    },
    "userName": {
      "type": "string",
      "default": ""
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "creatureId",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}