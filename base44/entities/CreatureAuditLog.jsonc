{
  "name": "CreatureAuditLog",
  "type": "object",
  "properties": {
    "creatureId": {
      "type": "string"
    },
    "imageId": {
      "type": "string",
      "default": ""
    },
    "action": {
      "type": "string",
      "enum": [
        "generate_requested",
        "generate_completed",
        "generate_failed",
        "image_uploaded",
        "image_approved",
        "image_rejected",
        "default_changed",
        "unique_attack_updated"
      ]
    },
    "userId": {
      "type": "string",
      "default": ""
    },
    "userName": {
      "type": "string",
      "default": ""
    },
    "note": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "creatureId",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}