      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "in_progress"
      ],
      "default": "open"
    },
    "hostName": {
      "type": "string",
      "default": ""
    },
    "joinedUserId": {
      "type": "string",
      "default": ""
    },
    "joinedUserName": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "code"
  ]
}