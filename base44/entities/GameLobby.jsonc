{
  "name": "GameLobby",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "in_progress"
      ],
      "default": "open"
    },
    "hostName": {
      "type": "string",
      "default": ""
    },
    "joinedUserId": {
      "type": "string",
      "default": ""
    },
    "joinedUserName": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "code"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.joinedUserId": "{{user.id}}"
        },
        {
          "data.joinedUserId": ""
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}