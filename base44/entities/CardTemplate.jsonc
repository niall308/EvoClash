{
  "name": "CardTemplate",
  "type": "object",
  "properties": {
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature"
      ]
    },
    "tier1Animation": {
      "type": "string"
    },
    "tier2Animation": {
      "type": "string"
    },
    "tier3Animation": {
      "type": "string"
    },
    "tier4Animation": {
      "type": "string"
    }
  },
  "required": [
    "baseName",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}