{
  "name": "CreatureImage",
  "type": "object",
  "properties": {
    "creatureId": {
      "type": "string",
      "description": "FK to Creature.id. The creature this generated/uploaded image belongs to."
    },
    "tier": {
      "type": "number",
      "default": 1,
      "description": "Upgrade tier this image is a guide for (1\u20134). Tier 1 = base design; 2/3/4 = progressively upgraded looks. Clamped server-side."
    },
    "url": {
      "type": "string",
      "default": "",
      "description": "Public CDN URL of the image. Empty while a generation is still in progress."
    },
    "storageKey": {
      "type": "string",
      "default": "",
      "description": "Opaque storage key for the underlying asset (provider-specific). May be empty when the URL itself is the durable reference."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval state. 'pending' = generated/uploaded, awaiting admin review; 'approved' = selectable as a guide; 'rejected' = kept in history but not selectable."
    },
    "isGuide": {
      "type": "boolean",
      "default": false,
      "description": "True once an admin approves this image as a guide for the card generator. Only approved + isGuide images are eligible to be used as a card-art guide for this creature + tier."
    },
    "isDefaultForTier": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the default guide image for its creature + tier. At most one approved guide per creature per tier should have this set."
    },
    "generatedBy": {
      "type": "string",
      "default": "",
      "description": "Provider that produced this image: 'base44-core' (the platform GenerateImage integration) or 'manual' (admin upload)."
    },
    "authorId": {
      "type": "string",
      "default": "",
      "description": "User id of the admin who generated/uploaded this image. Mirrors the built-in created_by_id for convenience/querying."
    },
    "authorName": {
      "type": "string",
      "default": ""
    },
    "notes": {
      "type": "string",
      "default": "",
      "description": "Admin note attached on approve/reject (append-only log of decisions)."
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "The admin-authored detailed prompt used to generate this image (stored for traceability/audit; empty for manual uploads that had no prompt)."
    },
    "stylePreset": {
      "type": "string",
      "default": "",
      "description": "Style preset id applied at generation time (e.g. 'semi-realistic')."
    },
    "isDefault": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the creature's default reference image (creature-level, tier-agnostic). At most one approved image per creature should have this set; mirrored onto Creature.referenceImageUrl."
    },
    "errorMessage": {
      "type": "string",
      "default": "",
      "description": "Populated when a generation attempt failed for this image; the record is kept for audit."
    }
  },
  "required": [
    "creatureId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}