{
  "name": "CreatureImage",
  "type": "object",
  "properties": {
    "creatureId": {
      "type": "string",
      "description": "FK to Creature.id. The creature this generated/uploaded image belongs to."
    },
    "tier": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4
      ],
      "default": 1,
      "description": "Upgrade tier this image is a concept/guide for (1=Base, 2=Enhanced, 3=Major, 4=Legendary). Drives tier guidance + the card generator's Choose Guide step."
    },
    "url": {
      "type": "string",
      "default": "",
      "description": "Public CDN URL of the image. Empty while a generation is still in progress."
    },
    "storageKey": {
      "type": "string",
      "default": "",
      "description": "Opaque storage key for the underlying asset (provider-specific). May be empty when the URL itself is the durable reference."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Approval state. 'pending' = generated/uploaded, awaiting admin review; 'approved' = selectable as a guide; 'rejected' = kept in history but not selectable."
    },
    "isGuide": {
      "type": "boolean",
      "default": false,
      "description": "True once an admin approves this image as a guide for the card generator. Only approved isGuide=true images are exposed to the card generator's Choose Guide step."
    },
    "isDefaultForTier": {
      "type": "boolean",
      "default": false,
      "description": "The default guide image for this creature + tier. At most one approved image per (creature, tier) should have this set."
    },
    "generatedBy": {
      "type": "string",
      "default": "",
      "description": "Provider that produced this image: 'base44-core' (the platform GenerateImage integration) or 'manual' (admin upload)."
    },
    "authorId": {
      "type": "string",
      "default": "",
      "description": "User id of the admin who generated/uploaded this image. Mirrors the built-in created_by_id for convenience/querying."
    },
    "authorName": {
      "type": "string",
      "default": ""
    },
    "notes": {
      "type": "string",
      "default": "",
      "description": "Admin note attached on approve/reject (append-only log of decisions)."
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "The final prompt sent to the image provider. When the admin left the prompt field empty, this is the auto-built tier-guidance prompt and promptAutoGenerated is true."
    },
    "promptAutoGenerated": {
      "type": "boolean",
      "default": false,
      "description": "True when the final prompt was built from tier guidance + creature metadata because the admin supplied no prompt text."
    },
    "stylePreset": {
      "type": "string",
      "default": "",
      "description": "Style preset id applied at generation time (e.g. 'semi-realistic')."
    },
    "isDefault": {
      "type": "boolean",
      "default": false,
      "description": "Creature-level default reference image (mirrored onto Creature.referenceImageUrl, which the card-art generator reads as the anatomy reference). Set together with isDefaultForTier when an admin sets a guide as the default for its tier."
    },
    "errorMessage": {
      "type": "string",
      "default": "",
      "description": "Populated when a generation attempt failed for this image; the record is kept for audit."
    }
  },
  "required": [
    "creatureId"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}