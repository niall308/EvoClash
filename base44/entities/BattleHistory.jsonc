{
  "name": "BattleHistory",
  "type": "object",
  "properties": {
    "opponentName": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "win",
        "loss"
      ]
    },
    "cardsUsed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "playerScore": {
      "type": "number"
    },
    "aiScore": {
      "type": "number"
    },
    "cardsDestroyed": {
      "type": "number",
      "default": 0
    },
    "damageDealt": {
      "type": "number",
      "default": 0
    },
    "blocksUsed": {
      "type": "number",
      "default": 0
    },
    "distinctTypesUsed": {
      "type": "number",
      "default": 0
    },
    "durationSeconds": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "opponentName",
    "outcome",
    "cardsUsed"
  ]
}