{
  "name": "BattleHistory",
  "type": "object",
  "properties": {
    "opponentName": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "win",
        "loss"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "ai",
        "pvp"
      ],
      "default": "ai",
      "description": "Whether this battle was against the AI or another player (PvP, online or offline). Used to keep leaderboards PvP-only."
    },
    "cardsUsed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "playerScore": {
      "type": "number"
    },
    "aiScore": {
      "type": "number"
    },
    "cardsDestroyed": {
      "type": "number",
      "default": 0
    },
    "damageDealt": {
      "type": "number",
      "default": 0
    },
    "blocksUsed": {
      "type": "number",
      "default": 0
    },
    "distinctTypesUsed": {
      "type": "number",
      "default": 0
    },
    "durationSeconds": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "opponentName",
    "outcome",
    "cardsUsed"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}