{
  "name": "AiDeckCard",
  "type": "object",
  "properties": {
    "difficulty": {
      "type": "string",
      "enum": [
        "Easy",
        "Normal",
        "Hard",
        "Extreme"
      ]
    },
    "name": {
      "type": "string"
    },
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature",
        "Hybrid"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "Fire",
        "Lava",
        "Water",
        "Ice",
        "Rock",
        "Wind",
        "Earth",
        "Magic",
        "Hyper Rare"
      ]
    },
    "tier": {
      "type": "number",
      "default": 1
    },
    "attack": {
      "type": "number"
    },
    "defense": {
      "type": "number"
    },
    "bonusDamage": {
      "type": "number",
      "default": 0
    },
    "isHybrid": {
      "type": "boolean",
      "default": false
    },
    "imageUrl": {
      "type": "string"
    },
    "uniqueAttackName": {
      "type": "string",
      "default": "",
      "description": "Display name of this creature's Unique Attack, stamped from the Creature entity at deck generation."
    },
    "uniqueAttackPercent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 250
    },
    "uniqueAttackTarget": {
      "type": "string",
      "enum": [
        "single",
        "multi"
      ],
      "default": "single"
    },
    "uniqueAttackEffect": {
      "type": "string",
      "default": "",
      "description": "Additional effect description for the Unique Attack, stamped from the Creature entity."
    },
    "uniqueAttackEffectType": {
      "type": "string",
      "enum": [
        "none",
        "healSelf50",
        "healAll30",
        "halfAttackTarget1",
        "heal_team_on_destroy",
        "custom"
      ],
      "default": "none",
      "description": "Structured Unique Attack effect, stamped from the Creature entity at deck generation."
    }
  },
  "required": [
    "difficulty",
    "name",
    "baseName",
    "category",
    "type",
    "tier",
    "attack",
    "defense"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}