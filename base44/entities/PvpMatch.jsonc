{
  "name": "PvpMatch",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "matchType": {
      "type": "string",
      "enum": [
        "live",
        "offline"
      ],
      "default": "live",
      "description": "'live' requires both players present; 'offline' has no turn time limit and can be left/resumed anytime."
    },
    "player1Id": {
      "type": "string"
    },
    "player1Name": {
      "type": "string",
      "default": ""
    },
    "player2Id": {
      "type": "string"
    },
    "player2Name": {
      "type": "string",
      "default": ""
    },
    "player1Rp": {
      "type": "number",
      "default": 0
    },
    "player2Rp": {
      "type": "number",
      "default": 0
    },
    "player1Pool": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "player2Pool": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "player1Card": {
      "type": "object",
      "default": {}
    },
    "player2Card": {
      "type": "object",
      "default": {}
    },
    "player1Hand": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "player2Hand": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "player1PendingHybrid": {
      "type": "object",
      "default": {}
    },
    "player2PendingHybrid": {
      "type": "object",
      "default": {}
    },
    "player1DoubleAttackActive": {
      "type": "boolean",
      "default": false
    },
    "player2DoubleAttackActive": {
      "type": "boolean",
      "default": false
    },
    "player1TripleDefenseActive": {
      "type": "boolean",
      "default": false
    },
    "player2TripleDefenseActive": {
      "type": "boolean",
      "default": false
    },
    "player1BlockActive": {
      "type": "boolean",
      "default": false
    },
    "player2BlockActive": {
      "type": "boolean",
      "default": false
    },
    "player1AttackHalvedTurns": {
      "type": "number",
      "default": 0
    },
    "player2AttackHalvedTurns": {
      "type": "number",
      "default": 0
    },
    "player1TempTierBoost": {
      "type": "object",
      "default": {}
    },
    "player2TempTierBoost": {
      "type": "object",
      "default": {}
    },
    "player1Hp": {
      "type": "number",
      "default": 0
    },
    "player2Hp": {
      "type": "number",
      "default": 0
    },
    "player1Rps": {
      "type": "string",
      "default": ""
    },
    "player2Rps": {
      "type": "string",
      "default": ""
    },
    "rpsDone": {
      "type": "boolean",
      "default": false
    },
    "round": {
      "type": "number",
      "default": 1
    },
    "scoreP1": {
      "type": "number",
      "default": 0
    },
    "scoreP2": {
      "type": "number",
      "default": 0
    },
    "turn": {
      "type": "string",
      "default": ""
    },
    "phase": {
      "type": "string",
      "default": "draw"
    },
    "log": {
      "type": "string",
      "default": "Waiting for both players..."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "finished"
      ],
      "default": "active"
    },
    "winnerId": {
      "type": "string",
      "default": ""
    },
    "player1CoinsEarned": {
      "type": "number",
      "default": 0
    },
    "player2CoinsEarned": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code",
    "player1Id",
    "player2Id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.player1Id": "{{user.id}}"
        },
        {
          "data.player2Id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.player1Id": "{{user.id}}"
        },
        {
          "data.player2Id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}