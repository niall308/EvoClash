{
  "name": "Card",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature",
        "Hybrid"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "Fire",
        "Lava",
        "Water",
        "Ice",
        "Rock",
        "Wind",
        "Earth",
        "Magic",
        "Hyper Rare"
      ]
    },
    "tier": {
      "type": "number",
      "default": 1
    },
    "attack": {
      "type": "number"
    },
    "defense": {
      "type": "number"
    },
    "bonusDamage": {
      "type": "number",
      "default": 0
    },
    "isHybrid": {
      "type": "boolean",
      "default": false
    },
    "winsVsBonus": {
      "type": "number",
      "default": 0
    },
    "winsVsNonBonus": {
      "type": "number",
      "default": 0
    },
    "gamesPlayed": {
      "type": "number",
      "default": 0
    },
    "totalWins": {
      "type": "number",
      "default": 0
    },
    "totalGames": {
      "type": "number",
      "default": 0
    },
    "matchWins": {
      "type": "number",
      "default": 0
    },
    "claimedCardMilestones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "imageUrl": {
      "type": "string"
    },
    "attackUpgradesUsed": {
      "type": "number",
      "default": 0
    },
    "defenseUpgradesUsed": {
      "type": "number",
      "default": 0
    },
    "bonusDamageUpgradesUsed": {
      "type": "number",
      "default": 0
    },
    "typeChanged": {
      "type": "boolean",
      "default": false
    },
    "deckId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string",
      "description": "Current owner's user id. Mutable (unlike the built-in created_by_id) so cards can change hands via trades."
    }
  },
  "required": [
    "name",
    "baseName",
    "category",
    "type",
    "tier",
    "attack",
    "defense"
  ],
  "rls": {
    "create": {
      "data.ownerId": "{{user.id}}"
    },
    "read": {
      "data.ownerId": "{{user.id}}"
    },
    "update": {
      "data.ownerId": "{{user.id}}"
    },
    "delete": {
      "data.ownerId": "{{user.id}}"
    }
  }
}