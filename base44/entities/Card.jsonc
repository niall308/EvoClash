{
  "name": "Card",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "baseName": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Dinosaur",
        "Extinct Animal",
        "Mythical Creature",
        "Hybrid",
        "Prototype"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "Fire",
        "Lava",
        "Water",
        "Ice",
        "Rock",
        "Wind",
        "Earth",
        "Magic",
        "Hyper Rare"
      ]
    },
    "tier": {
      "type": "number",
      "default": 1
    },
    "attack": {
      "type": "number"
    },
    "defense": {
      "type": "number"
    },
    "bonusDamage": {
      "type": "number",
      "default": 0
    },
    "isHybrid": {
      "type": "boolean",
      "default": false
    },
    "winsVsBonus": {
      "type": "number",
      "default": 0
    },
    "winsVsNonBonus": {
      "type": "number",
      "default": 0
    },
    "gamesPlayed": {
      "type": "number",
      "default": 0
    },
    "totalWins": {
      "type": "number",
      "default": 0
    },
    "totalGames": {
      "type": "number",
      "default": 0
    },
    "matchWins": {
      "type": "number",
      "default": 0
    },
    "claimedCardMilestones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "imageUrl": {
      "type": "string"
    },
    "attackUpgradesUsed": {
      "type": "number",
      "default": 0
    },
    "defenseUpgradesUsed": {
      "type": "number",
      "default": 0
    },
    "bonusDamageUpgradesUsed": {
      "type": "number",
      "default": 0
    },
    "typeChanged": {
      "type": "boolean",
      "default": false
    },
    "deckId": {
      "type": "string"
    },
    "ownerId": {
      "type": "string",
      "description": "Current owner's user id. Mutable (unlike the built-in created_by_id) so cards can change hands via trades."
    },
    "uniqueAttackName": {
      "type": "string",
      "default": "",
      "description": "Display name of this creature's Unique Attack, stamped from the Creature entity at creation."
    },
    "uniqueAttackPercent": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 250,
      "description": "Damage percentage of the Unique Attack (0\u2013250), stamped from the Creature entity."
    },
    "uniqueAttackTarget": {
      "type": "string",
      "enum": [
        "single",
        "multi"
      ],
      "default": "single",
      "description": "Whether the Unique Attack hits one card (single) or all opposing cards (multi)."
    },
    "uniqueAttackEffect": {
      "type": "string",
      "default": "",
      "description": "Additional effect description for the Unique Attack, stamped from the Creature entity."
    },
    "uniqueAttackEffectType": {
      "type": "string",
      "default": "",
      "description": "Explicit engine effect type for this card's Unique Attack, taking precedence over text mapping. Used by egg-hatchling cards (baby/good/evil) to map to deterministic mechanics."
    },
    "isEggHatchling": {
      "type": "boolean",
      "default": false,
      "description": "True if this card was hatched from a Creature Egg (baby form). Such cards use the egg upgrade path instead of the normal tier-evolve path."
    },
    "eggCreatureId": {
      "type": "string",
      "default": "",
      "description": "Id of the Creature entity this egg hatchling was spawned from. Used to resolve the upgraded image/name on upgrade."
    },
    "eggUpgraded": {
      "type": "boolean",
      "default": false,
      "description": "True once an egg hatchling has been evolved into its special upgraded (Tier 4) form. Prevents re-upgrading."
    },
    "eggAlignment": {
      "type": "string",
      "enum": [
        "",
        "good",
        "evil"
      ],
      "default": "",
      "description": "Alignment chosen at upgrade time for an egg hatchling's upgraded (Tier 4) form. 'good' = Blessed Strike (110% dmg + heal team 35%), 'evil' = Cursed Strike (175% dmg + sacrifice team 15%). Empty for baby hatchlings and non-egg cards."
    }
  },
  "required": [
    "name",
    "baseName",
    "category",
    "type",
    "tier",
    "attack",
    "defense"
  ],
  "rls": {
    "create": {
      "data.ownerId": "{{user.id}}"
    },
    "read": {
      "data.ownerId": "{{user.id}}"
    },
    "update": {
      "data.ownerId": "{{user.id}}"
    },
    "delete": {
      "data.ownerId": "{{user.id}}"
    }
  }
}