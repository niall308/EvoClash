{
  "name": "MatchQueue",
  "type": "object",
  "properties": {
    "rankPoints": {
      "type": "number",
      "default": 0
    },
    "matchType": {
      "type": "string",
      "enum": [
        "live",
        "offline"
      ],
      "default": "live"
    },
    "status": {
      "type": "string",
      "enum": [
        "searching",
        "matched",
        "cancelled"
      ],
      "default": "searching"
    },
    "matchCode": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "rankPoints"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}