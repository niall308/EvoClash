{
  "name": "CoinTransaction",
  "type": "object",
  "properties": {
    "packId": {
      "type": "string"
    },
    "priceUsd": {
      "type": "number"
    },
    "coinsAdded": {
      "type": "number"
    },
    "oldCoinTotal": {
      "type": "number"
    },
    "newCoinTotal": {
      "type": "number"
    },
    "sessionId": {
      "type": "string",
      "description": "Idempotency key \u2014 the Stripe session/charge/dispute id. Prevents a replayed webhook from granting (or deducting) coins twice."
    }
  },
  "required": [
    "packId",
    "priceUsd",
    "coinsAdded",
    "oldCoinTotal",
    "newCoinTotal"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}