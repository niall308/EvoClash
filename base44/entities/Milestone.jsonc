{
  "name": "Milestone",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "metric": {
      "type": "string",
      "enum": [
        "gamesPlayed",
        "wins",
        "losses",
        "aiGamesPlayed"
      ]
    },
    "target": {
      "type": "number"
    },
    "coinReward": {
      "type": "number"
    },
    "repeatable": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "metric",
    "target",
    "coinReward"
  ]
}